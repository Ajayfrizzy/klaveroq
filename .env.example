DATABASE_URL=postgresql://klaveroq:klaveroq_local@127.0.0.1:5433/klaveroq
APP_URL=http://127.0.0.1:3000
SESSION_COOKIE_NAME=klaveroq_session
SESSION_TTL_DAYS=30
SESSION_SECRET=replace-with-a-long-random-value
# Base64-encoded 32-byte key. Required when MFA is enabled in production.
MFA_ENCRYPTION_KEY=
EMAIL_PROVIDER=local
EMAIL_FROM=Klaveroq <accounts@example.com>
RESEND_API_KEY=
# Hosted environments: EMAIL_PROVIDER=resend; verify a domain you control in Resend.
# EMAIL_FROM must use that verified domain, e.g. Klaveroq <accounts@mail.yourdomain.com>.
# Set APP_URL to the public HTTPS origin, without a path or trailing slash.
# Subscribe https://YOUR_APP_HOST/api/webhooks/resend to email.delivered,
# email.bounced, email.complained, email.failed and email.suppressed.
RESEND_WEBHOOK_SECRET=
CKB_NETWORK=testnet
CKB_RPC_URL=https://testnet.ckb.dev
# Set to 1 only after PactAgent records confirmed settlements and the funded Testnet issuer is ready.
KLAVEROQ_VELLUM_ISSUER_ENABLED=0
KLAVEROQ_VELLUM_ISSUER_DID=
KLAVEROQ_VELLUM_ISSUER_CKB_PRIVATE_KEY=
KLAVEROQ_VELLUM_MIN_CONFIRMATIONS=6
# Allowed stages: development, community_beta, production.
DEPLOYMENT_STAGE=development
# Local sandbox only. Hosted beta: DEPLOYMENT_STAGE=community_beta and IDENTITY_PROVIDER=disabled.
# Allowed providers: sandbox, disabled. No real provider adapter is implemented yet;
# full-production readiness remains blocked until one is integrated and registered.
IDENTITY_PROVIDER=sandbox
IDENTITY_SANDBOX_ENABLED=0
# Affordable hosted beta: false. Explicit true requires object storage + ClamAV when hosted.
# Unset preserves local development behavior; invalid values disable uploads and fail readiness.
FILE_UPLOADS_ENABLED=false
# These storage/scanner settings are development defaults, not hosted fallbacks.
# Object storage + ClamAV are optional ONLY for the explicit disabled-upload community beta.
# To test local uploads, set FILE_UPLOADS_ENABLED=true.
FILE_STORAGE_BACKEND=filesystem
FILE_STORAGE_ROOT=.data/uploads
# Hosted-only: regional Spaces API endpoint (not bucket URL or CDN).
SPACES_REGION=ams3
SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
SPACES_BUCKET=
# Isolate environments; keep this prefix stable across deployments.
SPACES_PREFIX=community-beta/
# Set both as encrypted RUN_TIME App Platform secrets, never NEXT_PUBLIC_*.
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Alternative S3-compatible provider: set FILE_STORAGE_BACKEND=s3.
# Use the provider's HTTPS S3 API endpoint and signing region (not a console/CDN URL).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=community-beta/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true uses endpoint/bucket/key; false uses bucket.endpoint/key.
S3_FORCE_PATH_STYLE=false
# Keep the bucket private. Enable only if the provider supports object ACLs.
S3_PRIVATE_ACL=false
FILE_SCANNER=local
CLAMAV_HOST=
CLAMAV_PORT=3310
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional privacy-safe error event receiver. No request bodies, user data, or stack traces are sent.
ERROR_MONITORING_WEBHOOK_URL=
ERROR_MONITORING_TOKEN=
# Required for authenticated internal scheduled jobs in production (minimum 32 characters).
CRON_SECRET=
# Every minute: POST APP_URL/api/internal/notifications/retry with
# Authorization: Bearer CRON_SECRET. When Vellum issuance is enabled, also POST
# APP_URL/api/internal/vellum/claims/retry every minute. Schedule the retention job daily.
# Development/E2E sandbox only. Never configure in hosted production.
SANDBOX_SECRET=
