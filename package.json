{
  "name": "klaveroq",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@klaveroq/web",
    "build": "npm run build --workspace=@klaveroq/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace=@klaveroq/web",
    "typecheck": "npm run typecheck --workspace=@klaveroq/web",
    "test": "npm run test --workspace=@klaveroq/web",
    "db:generate": "npm run db:generate --workspace=@klaveroq/web",
    "db:migrate": "npm run db:migrate --workspace=@klaveroq/web",
    "db:seed": "npm run db:seed --workspace=@klaveroq/web"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "next@16.2.11": {
      "postcss": "8.5.12",
      "sharp": "0.35.0"
    }
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
